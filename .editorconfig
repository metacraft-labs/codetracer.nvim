# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[Justfile]
indent_size = 4

# Vim help files align by their own conventions (:help help-writing).
[doc/*.txt]
indent_style = unset
indent_size = unset
